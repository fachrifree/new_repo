{
  "rewrites": [
    {
      "source": "/api/sentiment",
      "destination": "https://br-lucky-king-b3liquce-sentimentapi.compute.c-4.ap-southeast-1.aws.neon.tech/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ]
}